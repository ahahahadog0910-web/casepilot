# Node.js 代理服务
PORT=3001

# 初期使用百炼 OpenAI 兼容接口。后续可切换为 mock 或其他 OpenAI 兼容服务。
MODEL_PROVIDER=bailian
MODEL_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.8-flash

# 阶段 3 多模型评测时可填写逗号分隔的模型名称；留空则使用 MODEL_NAME。
# MODEL_EVAL_MODELS=qwen-plus,qwen-turbo,qwen-max
# 百炼限流时可先只跑少量样本，并在请求之间增加间隔（0 表示不限制/不等待）。
# MODEL_EVAL_CASE_LIMIT=1
# MODEL_EVAL_DELAY_MS=2000

# 填写百炼控制台创建的 API Key。不要提交真实 Key 到 Git。
MODEL_API_KEY=

# 模型请求超时时间（毫秒）
MODEL_TIMEOUT_MS=120000

# 没有 Key 时可以改为 mock，先验证前后端链路：
# MODEL_PROVIDER=mock

